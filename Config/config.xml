<?xml version="1.0" encoding="UTF-8" ?>

<config xmlns="http://thelia.net/schema/dic/config"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://thelia.net/schema/dic/config http://thelia.net/schema/dic/config/thelia-1.0.xsd">

    <!--
        Thelia 3 migration: loops, forms, hooks and routes are now auto-discovered.
        - Loops  : Predict\Loop\* (BaseLoop / ArraySearchLoopInterface) are auto-registered.
        - Forms  : Predict\Form\* are auto-registered by their getName().
        - Hooks  : Predict\Hook\Back\* declare getSubscribedHooks() (back-office config + order edit).
        - Routes : #[Route] attributes on Predict\Controller\* replace the former Config/routing.xml.
    -->

</config>
